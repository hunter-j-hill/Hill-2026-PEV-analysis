# =============================================================================

sv_transform <- function(y) {
  # Smithson & Verkuilen (2006, Psychological Methods) squeeze for beta regression.
  # Maps [0,1] to open interval (0,1).
  n <- length(y)
  (y * (n - 1) + 0.5) / n
}

run_beta_glmm <- function(dat, grp_col, val_col, cluster_col, grp1, grp2, label) {
  # Beta GLMM: red ~ treatment + s(cluster, bs="re"), family = betar()
  # grp1 is the "higher" group (typically CI or infected)
  
  sub <- dat |>
    filter(.data[[grp_col]] %in% c(grp1, grp2),
           !is.na(.data[[val_col]]),
           !is.na(.data[[cluster_col]]),
           .data[[cluster_col]] != "") |>
    mutate(
      treatment = factor(if_else(.data[[grp_col]] == grp1, 1L, 0L)),
      cluster = factor(.data[[cluster_col]]),
      y_raw = .data[[val_col]],
      y = sv_transform(y_raw)
    )
  
  stats <- sub |>
    group_by(treatment) |>
    summarise(n = n(), mean = mean(y_raw), ncl = n_distinct(cluster), .groups = "drop")
  
  n1 <- stats$n[stats$treatment == 1]
  n2 <- stats$n[stats$treatment == 0]
  mean1 <- stats$mean[stats$treatment == 1]
  mean2 <- stats$mean[stats$treatment == 0]
  ncl1 <- stats$ncl[stats$treatment == 1]
  ncl2 <- stats$ncl[stats$treatment == 0]
  
  mw <- wilcox.test(sub$y_raw[sub$treatment == 1], sub$y_raw[sub$treatment == 0])
  
  result <- tryCatch({
    m <- gam(y ~ treatment + s(cluster, bs = "re"), family = betar(), data = sub)
    s <- summary(m)
    coef <- s$p.table["treatment1", "Estimate"]
    se <- s$p.table["treatment1", "Std. Error"]
    p <- s$p.table["treatment1", "Pr(>|z|)"]
    re_sd <- gam.vcomp(m)[1, "std.dev"]
    list(coef = coef, se = se, p = p, re_sd = re_sd, status = "OK")
  }, error = function(e) {
    list(coef = NA_real_, se = NA_real_, p = NA_real_, re_sd = NA_real_,
         status = str_c("FAILED: ", e$message))
  })
  
  tibble(
    label = label, grp1 = grp1, grp2 = grp2,
    n1 = n1, n2 = n2, ncl1 = ncl1, ncl2 = ncl2,
    mean1 = round(mean1, 4), mean2 = round(mean2, 4),
    diff = round(mean1 - mean2, 4),
    mw_p = mw$p.value,
    glmm_coef = result$coef, glmm_se = result$se, glmm_p = result$p,
    re_sd = result$re_sd,
    method = "beta_GLMM", status = result$status
  )
}

run_mw <- function(dat, grp_col, val_col, grp1, grp2, label, reason) {
  sub <- dat |>
    filter(.data[[grp_col]] %in% c(grp1, grp2), !is.na(.data[[val_col]]))
  
  v1 <- sub |> filter(.data[[grp_col]] == grp1) |> pull(.data[[val_col]])
  v2 <- sub |> filter(.data[[grp_col]] == grp2) |> pull(.data[[val_col]])
  
  mw <- wilcox.test(v1, v2)
  
  tibble(
    label = label, grp1 = grp1, grp2 = grp2,
    n1 = length(v1), n2 = length(v2), ncl1 = NA_integer_, ncl2 = NA_integer_,
    mean1 = round(mean(v1), 4), mean2 = round(mean(v2), 4),
    diff = round(mean(v1) - mean(v2), 4),
    mw_p = mw$p.value,
    glmm_coef = NA_real_, glmm_se = NA_real_, glmm_p = NA_real_, re_sd = NA_real_,
    method = "MW", status = reason
  )
}

format_p <- function(p) {
  case_when(
    is.na(p) ~ "—",
    p < 0.001 ~ sprintf("%.2e", p),
    TRUE ~ sprintf("%.4f", p)
  )
}


