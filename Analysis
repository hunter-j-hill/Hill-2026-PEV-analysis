    "CI_C1dx", "UxU_c1dx", "2D: C(1)DX CI vs UU"),
  run_mw(d2d, "name", "red",
    "CI_XO", "UxU_XO", "2D: X/O CI vs UU", "n=11+6, too few for GLMM"),
  run_beta_glmm(d2d, "name", "red", "date",
    "CI_w1118", "UxU_w1118", "2D: w1118 CI vs UU")
) |>
  mutate(
    best_p = coalesce(glmm_p, mw_p),
    bh_p = p.adjust(best_p, method = "BH")
  )

cat("\n  BH-corrected p-values (Fig 2D):\n")
fig2d |>
  select(label, best_p, bh_p) |>
  pwalk(~ cat(sprintf("    %s: raw = %s, BH = %s\n", ..1, format_p(..2), format_p(..3))))


