combined_3 <- bind_rows(
  d3c |> transmute(group = "CI", red, cluster = str_c("CI_", vial)),
  d3d |> transmute(group = "UU", red, cluster = str_c("UU_", name))
)

fig3 <- run_beta_glmm(combined_3, "group", "red", "cluster", "CI", "UU",
                       "3C/3D: yw CI vs UU")

# Correlation on vial means
ci_vial <- d3c |>
  group_by(vial) |>
  summarise(red = mean(red), EAV = mean(EAV), .groups = "drop")
cor_ci <- cor.test(ci_vial$red, ci_vial$EAV, method = "pearson")

uu_vial <- d3d |>
  group_by(name) |>
  summarise(red = mean(red), EAV = mean(EAV), .groups = "drop")
cor_uu <- cor.test(uu_vial$red, uu_vial$EAV, method = "pearson")

cat(sprintf("  Correlation (CI vial means): r = %.3f, p = %.4f\n", cor_ci$estimate, cor_ci$p.value))
cat(sprintf("  Correlation (UU vial means): r = %.3f, p = %.4f\n", cor_uu$estimate, cor_uu$p.value))


