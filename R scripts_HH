#install the whole tidyverse:
install.packages("tidyverse")

# Alternatively, install just ggplot2:
install.packages("ggplot2")

library(tidyverse)

library(ggplot2)

# Load a CSV file named "my_data.csv" from the current working directory
my_data <- read.csv("3_C_Book3.csv", header = TRUE, sep = ",")

#sort by vial ID (date) used for Fig S3A and S3B
ggplot(my_data, aes(x = factor(vial, levels = sort(unique(vial))), y = red)) +
  geom_boxplot(outlier.shape = NA) +
  geom_jitter(width = 0.15, alpha = 0.3, size = 0.8) +
  coord_cartesian(ylim = c(0, 1)) +
  scale_y_continuous(breaks = seq(0, 1, by = 0.25))

#jittered box plot based on order in spreadsheet, 
#outliershape=NA prevents outliers from being plotted twice
#used for Figs 1F, 2C, 2D, 4A, 4B, S6E
ggplot(my_data, aes(x = factor(name, levels = unique(name)), y = red)) +
  geom_boxplot(outlier.shape = NA) +
  geom_jitter(width = 0.15, alpha = 0.3, size = 0.8)

#jittered CI strength 
#used for Figs 3C and 3D
ggplot(my_data, aes(x = reorder(factor(name), EAV), y = red)) +
  geom_boxplot(outlier.shape = NA) +
  geom_jitter(width = 0.15, alpha = 0.3, size = 0.8)

#same as above but Y axis goes to 1
ggplot(my_data, aes(x = reorder(factor(name), EAV), y = red)) +
  geom_boxplot(outlier.shape = NA) +
  geom_jitter(width = 0.15, alpha = 0.3, size = 0.8) +
  coord_cartesian(ylim = c(0, 1)) +
  scale_y_continuous(breaks = seq(0, 1, by = 0.25))

#Pearsons R, used for figs S3C and S3D
ggplot(my_data, aes(x = EAV, y = red)) +
  geom_point() +
  geom_smooth(method = "lm", se = TRUE) +
  labs(title = "Pearson Correlation",
       subtitle = paste("r =", 
                        round(cor(my_data$EAV, my_data$red, 
                                  use = "complete.obs"), 2)),
       x = "EAV",
       y = "Red")



