install.packages("ggpubr")

library(ggplot2)
library(ggpubr)

# define the 5 comparisons (use your real group names)
comparisons <- list(
  c("U fathers", "I fathers"),
  c("CI_C1dx", "UxU_c1dx"),
  c("CI_XO", "UxU_XO"),
  c("CI_w1118", "UxU_w1118"),
  c("IxU _yw", "IxI_yw")
)

# build plot — note the + is at the END of the previous line
library(ggplot2)
library(ggpubr)

ggplot(my_data, aes(x = factor(name, levels = unique(name)), y = red)) +
  geom_boxplot() +
  
  # extend axis slightly beyond 1
  scale_y_continuous(limits = c(0, 1.1), expand = c(0, 0)) +
  
  # add p-values above 1
  stat_compare_means(
    comparisons = comparisons,
    method = "wilcox.test",
    method.args = list(exact = FALSE),
    p.adjust.method = "BH",
    label = "p.format",
    label.y = c(1.02, 1.04, 1.06, 1.08, 1.10)
  ) +
  
  # allow drawing outside panel
  coord_cartesian(clip = "off") +
  
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    plot.margin = margin(t = 20)  # extra top margin
  )
