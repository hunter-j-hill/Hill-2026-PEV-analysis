# helper to run a safe wilcox test and compute approximate r
run_safe_wilcox <- function(data, grp_pair, yvar = "red", gvar = "name") {
  # subset
  sub <- subset(data, data[[gvar]] %in% grp_pair)
  
  # drop NA in yvar
  sub <- sub[!is.na(sub[[yvar]]), ]
  
  # check how many distinct groups in this subset
  levs <- unique(as.character(sub[[gvar]]))
  # trim whitespace in case of stray spaces
  levs <- trimws(levs)
  levs <- levs[levs != ""]
  
  if(length(levs) != 2) {
    return(data.frame(
      group1 = grp_pair[1],
      group2 = grp_pair[2],
      status = paste0("SKIPPED: found ", length(levs), " group(s): ", paste(levs, collapse = ", ")),
      W = NA, p_value = NA, n1 = NA, n2 = NA, N = NA, r = NA,
      stringsAsFactors = FALSE
    ))
  }
  
  # ensure factor levels are exactly the two groups (preserve order)
  sub[[gvar]] <- factor(as.character(sub[[gvar]]), levels = levs)
  
  # counts per group
  n1 <- sum(sub[[gvar]] == levs[1])
  n2 <- sum(sub[[gvar]] == levs[2])
  N <- n1 + n2
  
  if(N < 2) {
    return(data.frame(
      group1 = grp_pair[1],
      group2 = grp_pair[2],
      status = "SKIPPED: not enough observations",
      W = NA, p_value = NA, n1 = n1, n2 = n2, N = N, r = NA,
      stringsAsFactors = FALSE
    ))
  }
  
  # run Wilcoxon rank-sum (Mann-Whitney) - asymptotic (good for large N)
  test <- wilcox.test(sub[[yvar]] ~ sub[[gvar]], exact = FALSE, correct = FALSE)
  
  pval <- test$p.value
  Wstat <- as.numeric(test$statistic)
  
  # approximate effect size r = Z / sqrt(N)
  # compute Z from p-value (two-sided). Determine sign from median difference
  med_diff <- median(sub[[yvar]][sub[[gvar]] == levs[1]], na.rm = TRUE) -
    median(sub[[yvar]][sub[[gvar]] == levs[2]], na.rm = TRUE)
  # convert p to one-sided Z magnitude
  Zmag <- qnorm(pval / 2, lower.tail = FALSE)
  Z <- ifelse(med_diff < 0, -Zmag, Zmag)   # assign sign based on direction of medians
  r <- Z / sqrt(N)
  
  data.frame(
    group1 = levs[1],
    group2 = levs[2],
    status = "OK",
    W = Wstat,
    p_value = pval,
    n1 = n1,
    n2 = n2,
    N = N,
    r = r,
    stringsAsFactors = FALSE
  )
}

# run all comparisons and collect results
results <- lapply(pairs, function(p) run_safe_wilcox(my_data, p, yvar = "red", gvar = "name"))
results_df <- do.call(rbind, results)

# adjust p-values (BH) for tests that ran
valid_idx <- which(results_df$status == "OK")
results_df$p_adj_BH <- NA
if(length(valid_idx) > 0) {
  results_df$p_adj_BH[valid_idx] <- p.adjust(results_df$p_value[valid_idx], method = "BH")
}

# show results
print(results_df)


